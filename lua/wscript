#! /usr/bin/env python
# encoding: utf-8

from waflib import Utils
import os

top = '.'
# HL2SB (sbrust): GMod's architecture -- one shared Lua host for every realm.
# The Lua C API lives in lua_shared.dll / liblua_shared.so and third-party
# binary modules (lua/bin/gm{sv,cl}_*_*.dll, gmod13_open entry, see
# src/hl2sb_binmod.c) resolve lua_* at runtime from it, exactly like GMod
# modules resolve them from lua_shared.dll.
PROJECT_NAME = 'lua_shared'

def options(opt):
	return

def configure(conf):
	if conf.env.DEST_OS in ["linux", "android", "freebsd", "osx"]:
		conf.define( "LUA_USE_LINUX", 1 )
	return

def build(bld):
	# Lua 5.4.6, taken from Experiment: Source (src/lua), which additionally
	# carries the GLua syntax extensions this fork used to patch into 5.1:
	#   * `continue` keyword
	#   * `!` / `!=` operators
	#   * `&&` / `||` operators
	#   * `//` line comments and `/* ... */` block comments
	#   * package.seeall + module() backported from 5.1
	# bit.c is HL2SB's LuaBitOp, retargeted from the 5.1 build so existing mod
	# scripts that call bit.band/bit.bor keep working.
	source = [
		"src/lapi.c",
		"src/lauxlib.c",
		"src/lbaselib.c",
		"src/lcode.c",
		"src/lcorolib.c",
		"src/lctype.c",
		"src/ldblib.c",
		"src/ldebug.c",
		"src/ldo.c",
		"src/ldump.c",
		"src/lfunc.c",
		"src/lgc.c",
		"src/linit.c",
		"src/liolib.c",
		"src/llex.c",
		"src/lmathlib.c",
		"src/lmem.c",
		"src/loadlib.c",
		"src/lobject.c",
		"src/lopcodes.c",
		"src/loslib.c",
		"src/lparser.c",
		"src/lstate.c",
		"src/lstring.c",
		"src/lstrlib.c",
		"src/ltable.c",
		"src/ltablib.c",
		"src/ltm.c",
		"src/lundump.c",
		"src/lutf8lib.c",
		"src/lvm.c",
		"src/lzio.c",
		"src/bit.c",
		# HL2SB (sbrust): GMod 式第三方二进制模块加载器（gmod13_open/close 契约），
		# 随 lua_shared.dll 导出 HL2SB_InstallBinaryModuleSearcher/HL2SB_RunBinaryModuleCloses。
		"src/hl2sb_binmod.c",
	]

	includes = [
		'.',
		'./src',
		'../public',
		'../common'
	]

	defines = []

	libs = []

	# HL2SB (sbrust): on Windows the luaconf LUA_API branch needs
	# LUA_BUILD_AS_DLL so the sources compile with __declspec(dllexport)
	# (the .c files already carry LUA_CORE/LUA_LIB).  On ELF (linux/android)
	# LUA_BUILD_AS_DLL would emit MSVC-only __declspec and fail the compile --
	# instead LUA_BUILD_AS_SHARED makes luaconf.h mark LUA_API with
	# default visibility, because the global -fvisibility=hidden
	# (compiler_optimizations.py CFLAGS) would otherwise hide every API
	# symbol from liblua_shared.so's .dynsym and consumers could not link.
	if bld.env.DEST_OS == 'win32':
		defines += [ 'LUA_BUILD_AS_DLL' ]
	else:
		defines += [ 'LUA_BUILD_AS_SHARED' ]
	# dlopen/dlsym for loadlib.c (LUA_USE_DLOPEN) and libm for the math builtins.
	# Uselib names must be UPPER case: they index env.LIB_DL / env.LIB_M, the
	# stores check_deps (wscript:336/341) and xcompile.py:357 create via
	# check_cc's default uselib_store. A lowercase 'm' matches no store and is
	# silently dropped from the link line. Shlibs link with --no-undefined
	# (compiler_optimizations.py), so every symbol must resolve: bionic keeps
	# acos/pow/fmod/frexp in a separate libm.so, desktop glibc needs -lm too.
	if bld.env.DEST_OS in ( 'linux', 'android' ):
		libs += [ 'DL', 'M' ]

	# Desktop: next to the exe (D:\srceng\bin, tier0's neighbourhood) so
	# client.dll/server.dll resolve it from the application directory.
	# Android: same root as the game libs; the APK packaging picks it up from
	# there (scripts/build-android-arm64.sh copies it into jniLibs explicitly).
	install_path = bld.env.PREFIX
	if bld.env.DEST_OS == 'win32':
		install_path += '/bin'

	bld.shlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		# Lua is C: compiling it as C++ changes linkage for symbols that have no
		# prior declaration (e.g. LuaBitOp's luaopen_bit) and is not what upstream
		# supports.  Keep this target C-only.
		features = 'c',
		includes = includes,
		defines  = defines,
		use      = libs,
		install_path = install_path,
		idx      = bld.get_taskgen_count()
	)
