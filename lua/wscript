# harmless to always compile; lib_init.c carries luaL_openlibs).
LJ_LIB_UNITS = [
    LJ_SRC + '/lib_aux.c',
    LJ_SRC + '/lib_base.c',
    LJ_SRC + '/lib_bit.c',
    LJ_SRC + '/lib_debug.c',
    LJ_SRC + '/lib_ffi.c',
    LJ_SRC + '/lib_init.c',
    LJ_SRC + '/lib_io.c',
    LJ_SRC + '/lib_jit.c',
    LJ_SRC + '/lib_math.c',
