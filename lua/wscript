def options(opt):
	return

def configure(conf):
	if conf.env.DEST_OS == 'android':
		# Cross build: the target (NDK) compiler cannot run the build-time
		# generators, so a plain host compiler must be available on PATH.
		conf.find_program(['gcc', 'cc', 'clang'], var='HOST_CC', mandatory=True)

def _strip_tp(tg):
	# The top-level wscript puts /TP into global CFLAGS on win32 (every TU
	# in the game targets compiles as C++). The LuaJIT core and its host
	# tools are strict C (MSVC-specific: /TC wins over /TP in the same
	# flag list), so compile them as C the way the reference build does.
	if tg.env.DEST_OS == 'win32':
		tg.env.CFLAGS = [f for f in tg.env.CFLAGS if f != '/TP'] + ['/TC']

def _lj_arch(bld):
	if bld.env.DEST_CPU in ('x86', 'i386', 'i486', 'i586', 'i686'):
		return 'x86'
	if bld.env.DEST_CPU in ('aarch64', 'arm64'):
		return 'arm64'
	if bld.env.DEST_CPU in ('amd64', 'x86_64', 'x64'):
		return 'x64'
	raise Errors.WafError('lua_shared: unsupported target arch %s/%s' % (bld.env.DEST_OS, bld.env.DEST_CPU))

def build(bld):
	lj_arch = _lj_arch(bld)
	is_win = bld.env.DEST_OS == 'win32'
	# x64 builds run in GC64 mode (the reference engine ships GC64 on x64;
	# arm64 enables it through lj_arch.h unconditionally).
	is_gc64 = lj_arch == 'x64'

	ctx = bld.path.get_bld()
	src_dir = bld.path.make_node(LJ_SRC)
	dasm_dir = bld.path.make_node(LJ_DASM)

	exe_ext = '.exe' if is_win else ''
	ml_node = ctx.find_or_declare('minilua_host' + exe_ext)
	bvm_node = ctx.find_or_declare('buildvm_host' + exe_ext)

	# ------------------------------------------------------- host: minilua
	if bld.env.DEST_OS == 'android':
		ml_tg = bld(
			rule='${HOST_CC} -O2 -o ${TGT} ${SRC} -lm',
			source=[LJ_SRC + '/host/minilua.c'],
			target=ml_node,
			install_path=None,
			idx=bld.get_taskgen_count(),
		)
	else:
		ml_tg = bld(
			features='c cprogram',
			source=LJ_SRC + '/host/minilua.c',
			target='minilua_host',
			includes=LJ_SRC,
			lib=[] if is_win else ['m'],
			install_path=None,
			idx=bld.get_taskgen_count(),
		)
		_strip_tp(ml_tg)

	# --------------------------------------------- host: buildvm per arch
	if lj_arch == 'x64':
		# Mirror of the reference build script: vm_x64.dasc with JIT/P64 plus
		# WIN when the target is Windows. GC64 is a compile-time define
		# consumed by buildvm_arch.h's C-level guards and by the core itself.
		dasc = src_dir.make_node('vm_x64.dasc')
		dasm_flags = ['-LN', '-D', 'JIT', '-D', 'P64', '-D', 'FFI', '-D', 'FPU', '-D', 'ENDIAN_LE', '-D', 'HFABI']
		if is_win:
			dasm_flags += ['-D', 'WIN']
	elif lj_arch == 'x86':
		# The 32-bit VM uses the native x86 ABI and single-number mode.
		dasc = src_dir.make_node('vm_x86.dasc')
		dasm_flags = ['-LN', '-D', 'JIT', '-D', 'FFI', '-D', 'FPU', '-D', 'ENDIAN_LE', '-D', 'HFABI']
		if is_win:
			dasm_flags += ['-D', 'WIN']
	else:
		# arm64: the same flag set the stock Makefile derives for LJARCH=arm64.
		dasc = src_dir.make_node('vm_arm64.dasc')
		dasm_flags = ['-LN', '-D', 'ENDIAN_LE', '-D', 'P64', '-D', 'JIT', '-D', 'FFI', '-D', 'FPU', '-D', 'DUALNUM', '-D', 'VER=80']

	arch_hdr_node = ctx.find_or_declare(LJ_GEN + '/buildvm_arch.h')
	dasm_cmd = ' '.join([
		ml_node.abspath(),
		dasm_dir.make_node('dynasm.lua').abspath(),
	] + dasm_flags + [
		'-o', arch_hdr_node.abspath(),
		dasc.abspath(),
	])
	dasm_tg = bld(
		rule=dasm_cmd,
		source=[dasc, ml_node] + dasm_dir.ant_glob('*.lua'),
		target=arch_hdr_node,
		install_path=None,
		idx=bld.get_taskgen_count(),
	)
	dasm_tg.features = Utils.to_list(dasm_tg.features) + ['lj_dependencies']
	dasm_tg.lj_after = [ml_tg]

	bvm_sources = [
		LJ_SRC + '/host/buildvm.c',
		LJ_SRC + '/host/buildvm_asm.c',
		LJ_SRC + '/host/buildvm_peobj.c',
		LJ_SRC + '/host/buildvm_lib.c',
		LJ_SRC + '/host/buildvm_fold.c',
	]
	# buildvm_arch.h is generated, not compilable -- wire it as a dependency
	# of every buildvm unit instead of listing it in source (waf rejects
	# header extensions in source lists).
	for unit in list(bvm_sources):
		bld.add_manual_dependency(bld.path.make_node(unit), arch_hdr_node)
	bvm_includes = [LJ_SRC, LJ_DASM, LJ_GEN]
	if bld.env.DEST_OS == 'android':
		bvm_defines = ['-DLUAJIT_TARGET=LUAJIT_ARCH_' + lj_arch.upper()]
		if is_gc64:
			bvm_defines += ['-DLUAJIT_ENABLE_GC64']
		gen_abs = ctx.make_node(LJ_GEN).abspath()
		bvm_tg = bld(
			rule='${HOST_CC} -O2 ' + ' '.join(bvm_defines)
				+ ' -I' + src_dir.abspath()
				+ ' -I' + dasm_dir.abspath()
				+ ' -I' + gen_abs
				+ ' -o ${TGT} ${SRC}',
			source=bvm_sources,
			target=bvm_node,
			install_path=None,
			idx=bld.get_taskgen_count(),
		)
	else:
		bvm_tg = bld(
			features='c cprogram',
			source=bvm_sources,
			target='buildvm_host',
			includes=bvm_includes,
			defines=['LUAJIT_ENABLE_GC64'] if is_gc64 else [],
			install_path=None,
			idx=bld.get_taskgen_count(),
		)
		_strip_tp(bvm_tg)
	bvm_tg.features = Utils.to_list(bvm_tg.features) + ['lj_dependencies']
	bvm_tg.lj_after = [dasm_tg]

	# -------------------------------------- generated VM object + headers
	lib_nodes = [src_dir.make_node(name) for name in LJ_LIBS]

	gen_tgs = []

	def bvm_run(mode, target, source):
		cmd = ' '.join([bvm_node.abspath(), '-m', mode, '-o', target.abspath()]
			+ [n.abspath() for n in source])
		tg = bld(
			rule=cmd,
			source=source + [bvm_node],
			target=target,
			install_path=None,
			idx=bld.get_taskgen_count(),
		)
		tg.features = Utils.to_list(tg.features) + ['lj_dependencies']
		tg.lj_after = [bvm_tg]
		gen_tgs.append(tg)

	if is_win:
		lj_vm_node = ctx.find_or_declare(LJ_GEN + '/lj_vm.obj')
		bvm_run('peobj', lj_vm_node, [])
	else:
		# Use the target C compiler driver for preprocessed assembly. Waf's
		# generic assembler task has no AS configured on the Android path.
		vm_asm = ctx.find_or_declare(LJ_GEN + '/lj_vm.S')
		bvm_run('elfasm', vm_asm, [])
		lj_vm_node = ctx.find_or_declare(LJ_GEN + '/lj_vm.o')
		vm_tg = bld(
			rule='${CC} ${CFLAGS} -c ${SRC} -o ${TGT}',
			source=vm_asm,
			target=lj_vm_node,
			install_path=None,
			idx=bld.get_taskgen_count(),
		)
		vm_tg.features = Utils.to_list(vm_tg.features) + ['lj_dependencies']
		vm_tg.lj_after = [gen_tgs[-1]]
		gen_tgs.append(vm_tg)

	gen_headers = []
	for mode, name in [
		('bcdef', 'lj_bcdef.h'),
		('ffdef', 'lj_ffdef.h'),
		('libdef', 'lj_libdef.h'),
		('recdef', 'lj_recdef.h'),
	]:
		node = ctx.find_or_declare(LJ_GEN + '/' + name)
		bvm_run(mode, node, lib_nodes)
		gen_headers.append(node)
	fold_node = ctx.find_or_declare(LJ_GEN + '/lj_folddef.h')
	bvm_run('folddef', fold_node, [src_dir.make_node('lj_opt_fold.c')])
	gen_headers.append(fold_node)
	vmdef_node = ctx.find_or_declare(LJ_GEN + '/jit_vmdef.lua')
	bvm_run('vmdef', vmdef_node, lib_nodes)

	# -------------------------------------------- HL2SB glue (lua_shared)
	# hl2sb_hooks.c    - engine hook name registry (HL2SB_GetHookName/Count)
	# hl2sb_binmod.c   - binary-module searcher/loader/closes contract
	# hl2sb_glue.c     - CreateInterface / cvar / engine interface pointers /
	#                    AdvancedLuaErrorReporter (plain C twin)
	# All plain C with extern "C" exports; they ride the shlib taskgen's /TC.
	LJ_GLUE_C = [
		LJ_SRC + '/hl2sb/hl2sb_hooks.c',
		LJ_SRC + '/hl2sb/hl2sb_binmod.c',
		LJ_SRC + '/hl2sb/hl2sb_glue.c',
	]

	# hl2sb_glue_cpp.cpp - the C++-decorated half: the mangled
	# ?AdvancedLuaErrorReporter twin and the ?g_pFullFileSystem data export.
	# It must stay under C++ linkage (the shlib taskgen compiles as C), so it
	# is a separate objects taskgen linked in through use=.
	glue_cpp_tg = bld.objects(
		source   = [LJ_SRC + '/hl2sb/hl2sb_glue_cpp.cpp'],
		target   = 'lua_shared_glue_cpp',
		name     = 'lua_shared_glue_cpp',
		features = 'cxx',
		includes = [LJ_SRC],
		# LUA_LIB before lua.h -> LUA_API dllexports the reporter twin;
		# LUA_BUILD_AS_DLL gates the whole file (gcc builds fall back to the
		# plain-name twin from hl2sb_glue.c).
		defines  = (['LUA_BUILD_AS_DLL'] if is_win else []) + ['LUA_LIB'],
		install_path = None,
		idx      = bld.get_taskgen_count()
	)

	# --------------------------------------------------- lua_shared shlib
	# The generated definition headers are not listed in `source` (waf only
	# maps compilable extensions there); instead every core unit gets a
	# manual dependency on each of them, which both orders the compile after
	# the generators and re-runs the TU when a generated header changes
	# (waf does no header-dependency scanning of its own).
	source = LJ_CORE + LJ_LIB_UNITS + LJ_GLUE_C
	defines = []
	if is_win:
		defines += ['LUA_BUILD_AS_DLL']
	else:
		# ELF: LUA_API must carry default visibility (see luaconf.h); without
		# it the global -fvisibility=hidden buries the whole export surface.
		defines += ['LUA_BUILD_AS_SHARED']
	if is_gc64:
		defines += ['LUAJIT_ENABLE_GC64']

	libs = []
	# dlopen/dlsym for loadlib (lj_clib) and libm for the math builtins.
	# Uselib names must be UPPER case: they index env.LIB_DL / env.LIB_M, the
	# stores check_deps (top wscript) and xcompile.py create via check_cc's
	# default uselib_store. A lowercase 'm' matches no store and is silently
	# dropped from the link line. Shlibs link with --no-undefined
	# (compiler_optimizations.py), so every symbol must resolve: bionic keeps
	# acos/pow/fmod/frexp in a separate libm.so, desktop glibc needs -lm too.
	if bld.env.DEST_OS in ('linux', 'android'):
		libs += ['DL', 'M']

	# Desktop: next to the exe (D:\srceng\bin, tier0's neighbourhood) so
	# client.dll/server.dll resolve it from the application directory.
	# Android: same root as the game libs; the APK packaging picks it up from
	# there (scripts/build-android-arm64.sh copies it into jniLibs explicitly).
	install_path = bld.env.PREFIX
	if is_win:
		install_path += '/bin'

	lua_env = bld.env.derive()
	if is_win:
		lua_env.CFLAGS = [flag for flag in lua_env.CFLAGS if flag.lower() != '/fp:fast'] + ['/fp:precise']
	else:
		# Fast math breaks LuaJIT's NaN checks and the numeric constants used
		# to build tables from multiple return values.
		lua_env.CFLAGS = [
			'-O3' if flag == '-Ofast' else flag for flag in lua_env.CFLAGS
			if flag not in ('-ffast-math', '-funsafe-math-optimizations', '-ffinite-math-only')
		]

	shlib_tg = bld.shlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		# Lua is C: compiling it as C++ changes linkage for symbols that have
		# no prior declaration and is not what upstream supports. Keep this
		# target C-only.
		features = 'c',
		env      = lua_env,
		includes = [LJ_SRC, LJ_GEN],
		defines  = defines,
		use      = libs,
		install_path = install_path,
		idx      = bld.get_taskgen_count()
	)
	_strip_tp(shlib_tg)
	shlib_tg.features = Utils.to_list(shlib_tg.features) + ['lj_dependencies']
	shlib_tg.lj_after = gen_tgs
	shlib_tg.lj_headers = gen_headers
	shlib_tg.linkflags = Utils.to_list(getattr(shlib_tg, 'linkflags', [])) + [lj_vm_node.abspath()]
	shlib_tg.lj_object = lj_vm_node
	shlib_tg.use = Utils.to_list(shlib_tg.use) + ['lua_shared_glue_cpp']
	if not is_win:
		# LuaJIT's generated VM assembly has no .note.GNU-stack marker; without
		# this the ELF .so ships an executable-stack flag and Android 10+
		# rejects loading it (W^X), desktop glibc warns on every link.
		shlib_tg.env.append_unique('LINKFLAGS', ['-Wl,-z,noexecstack'])

	# HL2SB: the vendored SQLite amalgamation (public domain, sqlite.org), as
	# its own C static library linked into client and server -- the same
	# layout the reference implementation uses (each game DLL carries its own
	# copy and opens sv.db / cl.db respectively).  This cannot be a plain
	# entry in the game vpc lists: the game targets compile everything as C++
	# on MSVC (project-wide /TP), and the amalgamation is C-only source (it
	# uses C identifiers like `new` as variable names).  Linux and Android
	# compile .c as C already, so only the Windows taskgen needs the /TP
	# strip below.
	bld.stlib(
		source       = ['../game/shared/lua/sqlite/sqlite3.c'],
		target       = 'sqlite3_amalg',
		name         = 'sqlite3_amalg',
		features     = 'c cstlib',
		includes     = '.',
		# Nothing in the Lua surface needs extension loading, and dropping it
		# avoids a dlopen link dependency on linux/android.
		defines      = ['SQLITE_OMIT_LOAD_EXTENSION'],
		install_path = None,
		idx          = bld.get_taskgen_count()
	)
	if bld.env.DEST_OS == 'win32':
		tg = bld.get_tgen_by_name('sqlite3_amalg')
		tg.env.CFLAGS = [f for f in tg.env.CFLAGS if f != '/TP']
