    LJ_SRC + '/lj_api.c',
    LJ_SRC + '/lj_asm.c',
    LJ_SRC + '/lj_bc.c',
    LJ_SRC + '/lj_bcread.c',
    LJ_SRC + '/lj_bcwrite.c',
    LJ_SRC + '/lj_buf.c',
    LJ_SRC + '/lj_carith.c',
    LJ_SRC + '/lj_ccall.c',
    LJ_SRC + '/lj_ccallback.c',
    LJ_SRC + '/lj_cconv.c',
    LJ_SRC + '/lj_cdata.c',
    LJ_SRC + '/lj_char.c',
    LJ_SRC + '/lj_clib.c',
    LJ_SRC + '/lj_cparse.c',
    LJ_SRC + '/lj_crecord.c',
