#! /usr/bin/env python
# encoding: utf-8

from waflib import Utils, Errors
from waflib.TaskGen import feature, after_method
import os

top = '.'
# HL2SB (sbrust): GMod's architecture -- one shared Lua host for every realm.
# This branch runs the LuaJIT 2.1 core with the GLua dialect patches in-tree
# (see luajit/README.md): the Lua C API lives in lua_shared.dll /
# liblua_shared.so and third-party binary modules (lua/bin/gm{sv,cl}_*_*.dll,
# gmod13_open entry) resolve lua_* at runtime from it, exactly like GMod
# modules resolve them from lua_shared.dll.
#
# LuaJIT needs two build-time host tools before the core can compile:
#   minilua  - small host interpreter used to run the DynASM preprocessor
#   buildvm  - emits the per-target VM assembly object and the definition
#              headers (lj_bcdef.h / lj_ffdef.h / lj_libdef.h / lj_recdef.h /
#              lj_folddef.h / jit vmdef.lua)
# The tools must run on the BUILD machine, so:
#   - native targets (win32/linux) build them with the target toolchain
#     through regular waf program taskgens;
#   - the android cross build compiles them with a plain host compiler
#     probed from PATH (HOST_CC).
# Everything else (definition headers, lj_vm object, the shared library
# itself) is produced by ordinary waf tasks, so content-hash incremental
# rebuilds and cross-arch CI all go through the same graph.
PROJECT_NAME = 'lua_shared'

LJ_SRC = 'luajit/src'
LJ_DASM = 'luajit/dynasm'
LJ_GEN = 'luajit/gen'

@feature('lj_dependencies')
@after_method('process_rule', 'process_source')
def lj_dependencies(tg):
	for dependency in getattr(tg, 'lj_after', []):
		dependency.post()
		for task in tg.tasks:
			for prerequisite in dependency.tasks:
				task.set_run_after(prerequisite)
	for task in getattr(tg, 'compiled_tasks', []):
		task.dep_nodes.extend(getattr(tg, 'lj_headers', []))
	if getattr(tg, 'lj_object', None) and getattr(tg, 'link_task', None):
		tg.link_task.dep_nodes.append(tg.lj_object)

# LuaJIT core translation units (target compiled). ljamalg.c, luajit.c and
# probe_offsets.c are standalone-program units and stay out of the shlib.
LJ_CORE = [
