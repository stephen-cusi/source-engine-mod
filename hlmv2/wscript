#! /usr/bin/env python
# encoding: utf-8
#
# Half-Life Model Viewer 2 (Qt6 port of utils/hlmv).
#
# Follows the hammer2 Qt6 target pattern (hammer2/app/wscript): the Qt6
# waf tool from scripts/waifulib/qt6.py, C++17 flags on MSVC, and the
# Qt6EntryPoint shell32 shim for the WINDOWS subsystem on win32.
#
# The parser reuses the engine's public/studio.h structures (disk-layout
# compatible in this repository) and links mathlib for quaternion/matrix
# helpers; no engine modules (filesystem/materialsystem/mdlcache) are used.
#
# NOTE: stand-alone configure (outside the top-level wscript) must pass a
# build type, e.g. "python waf configure -T release".

VERSION = '0.0.1'
APPNAME = 'hlmv2'
top = '.'
PROJECT_NAME = 'hlmv2'

import os
import shutil

from waflib import Utils

def options(opt):
	# Standalone runs (not driven by the top-level wscript) need the
	# build-type and compiler options registered; when the top-level wscript
	# drives the build they already exist, so skip to avoid duplicate
	# registration.
	if opt.parser.get_option('--build-type') is None:
		opt.load('compiler_optimizations compiler_cxx qt6')
	return

def configure(conf):
	# Qt6 presence probe: skip hlmv2 entirely when Qt is not available so
	# configure stays green on machines/CI without Qt. Discovery mirrors the
	# qt6 tool order: QT6_ROOT/QTDIR environment variables, a win32 default
	# install path, then qmake6/qmake from PATH.
	qt6_root = os.environ.get('QT6_ROOT') or os.environ.get('QTDIR')
	if not qt6_root and conf.env.DEST_OS == 'win32':
		default_qt = 'D:/Qt/6.8.3/msvc2022_64'
		if os.path.isdir(default_qt):
			qt6_root = default_qt
			os.environ['QT6_ROOT'] = default_qt
			conf.environ['QT6_ROOT'] = default_qt
	if not qt6_root and not shutil.which('qmake6') and not shutil.which('qmake'):
		conf.env.HLMV2_QT = False
		conf.msg('hlmv2', 'Qt6 not found; skipping (set QT6_ROOT to enable)', 'YELLOW')
		return

	# Standalone configure (not driven by the top-level wscript): set up the
	# compiler first. The qt tool requires COMPILER_CXX to be defined.
	if 'COMPILER_CXX' not in conf.env:
		if conf.env.DEST_OS == 'win32':
			# Qt 6.8.3 msvc2022_64 ships x64 libraries only
			conf.env.MSVC_TARGETS = ['x64']
			conf.load('compiler_optimizations msvc compiler_cxx')
		else:
			conf.load('compiler_optimizations compiler_cxx')

	conf.want_qt6 = True
	conf.env.HLMV2_QT = True

	# Pin the Qt modules we need instead of scanning every library in QTLIBS
	conf.qt6_vars = ['Qt6Core', 'Qt6Gui', 'Qt6Widgets', 'Qt6OpenGL', 'Qt6OpenGLWidgets']

	if conf.env.COMPILER_CXX == 'msvc':
		# Qt6 requires a real C++17 toolchain report on MSVC
		# (qcompilerdetection.h errors out without /Zc:__cplusplus).
		msvc_qt_cxxflags = ['/std:c++17', '/Zc:__cplusplus', '/permissive-']
		conf.env.append_value('CXXFLAGS', msvc_qt_cxxflags)
		conf.load('qt6')
		conf.env['CXXFLAGS'] = [f for f in conf.env['CXXFLAGS'] if f not in msvc_qt_cxxflags]
	else:
		conf.load('qt6')

def build(bld):
	# Skipped during configure when Qt6 was not found
	if not bld.env.HLMV2_QT:
		return

	# The animation/bone pipeline is NOT reimplemented here. We compile the
	# engine's own public/ sources (the same set utils/studiomdl uses) into
	# this target and drive them through IBoneSetup/CStudioHdr; the Qt code is
	# only a front end (file I/O, GL drawing, widgets).
	source = [
		'main.cpp',
		'mainwindow.cpp',
		'viewport.cpp',
		'studiodata.cpp',
		'selftest.cpp',
		'materialloader.cpp',
		'localization.cpp',
		'../public/bone_setup.cpp',
		'../public/studio.cpp',
		'../public/collisionutils.cpp',
		'../public/interpolatortypes.cpp',
	]

	# Qt resource bundle: self-drawn icons (res/gen_icon.py) compiled in on
	# every platform. The separate win32 .rc below only carries the exe icon.
	source += ['res/hlmv2.qrc']

	# Headers containing Q_OBJECT (moc-ed automatically)
	moc_headers = [
		'mainwindow.h',
		'viewport.h',
		'localization.h',
	]

	includes = [
		'.',
		'../public',
		# studio.h / bone_setup.cpp pull in tier0..tier3 + mathlib headers
		'../public/tier0',
		'../public/tier1',
		'../public/tier2',
		'../public/tier3',
		'../public/vstdlib',
		'../public/mathlib',
	]

	# Engine headers use protected accessors; tools disable the guard the
	# same way utils/studiomdl does.
	defines = ['PROTECTED_THINGS_DISABLE']

	libs = []

	# Qt's entry point shim (WinMain -> main) is required on win32 when the
	# linker uses the WINDOWS subsystem; it depends on shell32
	# (CommandLineToArgvW). Other platforms need no shim.
	if bld.env.DEST_OS == 'win32':
		libs += ['Qt6EntryPoint', 'shell32']

	# Platform-specific bits; identical source set everywhere (pure Qt +
	# engine public headers).
	if bld.env.DEST_OS == 'win32':
		pass # no win32-specific sources/libraries
	elif bld.env.DEST_OS == 'linux':
		pass # no linux-specific sources/libraries
	elif bld.env.DEST_OS == 'darwin':
		pass # no macOS-specific sources/libraries

	# mathlib provides QuaternionMatrix/AngleQuaternion/QuaternionBlend used
	# by the bone setup and animation decode. tier0 supplies the symbols
	# mathlib references (GetCPUInformation, HushAsserts).
	uselib = 'QT6CORE QT6GUI QT6WIDGETS QT6OPENGL QT6OPENGLWIDGETS'
	engine_libs = ['mathlib', 'tier0', 'tier1', 'tier2', 'tier3', 'vstdlib', 'appframework']

	# Language flags: Qt6 needs C++17 on every toolchain
	if bld.env.COMPILER_CXX == 'msvc':
		# /Zc:strictStrings- restores the pre-/permissive- string-literal
		# conversion the engine's public/studio.cpp still relies on. The Qt
		# front end keeps /permissive-; no engine source is edited.
		cxxflags = ['/std:c++17', '/Zc:__cplusplus', '/permissive-', '/utf-8',
			'/Zc:strictStrings-']
	else:
		cxxflags = ['-std=c++17']

	kwargs = {}
	if bld.env.DEST_OS == 'win32' and 'MSVC_SUBSYSTEM' in bld.env:
		kwargs['subsystem'] = bld.env['MSVC_SUBSYSTEM']

	# get_taskgen_count() is defined by the top-level wscript; stand-alone
	# builds fall back to a fixed index (fine for a single target)
	if hasattr(bld, 'get_taskgen_count'):
		kwargs['idx'] = bld.get_taskgen_count()

	# Windows executables carry the icon as a compiled resource; other
	# platforms have no exe icon concept and skip the .rc entirely.
	features = 'qt6 cxx cxxprogram'
	if bld.env.DEST_OS == 'win32':
		source = source + ['res/hlmv.rc']
		features += ' winrc'

	bld.program(
		source    = source,
		moc       = moc_headers,
		target    = PROJECT_NAME,
		name      = PROJECT_NAME,
		features  = features,
		includes  = includes,
		defines   = defines,
		lib       = libs,
		use       = Utils.to_list(uselib) + engine_libs,
		cxxflags  = cxxflags,
		**kwargs
	)

	# Runtime catalogs live beside the executable in hlmvlang/ (hlmv_<locale>.qm).
	lang_dir = os.path.normpath( os.path.join( bld.path.abspath(), 'hlmvlang' ) )
	if os.path.isdir( lang_dir ):
		for catalog in sorted( os.listdir( lang_dir ) ):
			if catalog.endswith( '.ts' ):
				locale_name = catalog[:-3]
				bld(
					rule   = '${QT_LRELEASE} ${QT_LRELEASE_FLAGS} ${SRC} -qm ${TGT}',
					source = 'hlmvlang/' + catalog,
					target = 'hlmvlang/' + locale_name + '.qm',
					name   = 'hlmvlang_' + locale_name,
				)
