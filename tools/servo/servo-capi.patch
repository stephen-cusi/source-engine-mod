+/// Cancels all queued asset requests for one delegate on the Servo owner thread.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn servo_asset_cancel(user_data: *mut c_void) {
+    let loads = ASSET_PENDING.with(|pending| {
+        let mut pending = pending.borrow_mut();
+        let ids: Vec<u64> = pending.iter().filter_map(|(&id, (owner, _))|
+            (*owner == user_data as usize).then_some(id)).collect();
+        ids.into_iter().filter_map(|id| pending.remove(&id).map(|(_, load)| load)).collect::<Vec<_>>()
+    });
+    for load in loads { cancel_asset(load); }
+}
