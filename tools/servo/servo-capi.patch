+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn servo_bridge_reply(id: u64, value: *const c_char) -> bool {
+    if value.is_null() { return false; }
+    let Ok(value) = (unsafe { CStr::from_ptr(value) }).to_str() else { return false; };
+    BRIDGE_PENDING.with(|pending| {
+        let Some((_, mut prompt)) = pending.borrow_mut().remove(&id) else { return false; };
+        prompt.set_current_value(value);
+        prompt.confirm();
+        true
+    })
+}
