+#[test]
+fn test_user_script_precedes_first_head_script() {
+    let servo_test = ServoTest::new();
+    let (_, url) = make_server(move |_, response| {
+        *response.body_mut() = make_body(
+            b"<!doctype html><html><head><script>window.firstHeadValue = window.menuBridgeValue;</script></head></html>".to_vec(),
+        );
+    });
+    let manager = Rc::new(UserContentManager::new(servo_test.servo()));
+    let first = Rc::new(UserScript::from("window.menuBridgeValue = 41;"));
+    manager.add_script(first.clone());
+    let webview = WebViewBuilder::new(servo_test.servo(), servo_test.rendering_context.clone())
+        .user_content_manager(manager.clone())
+        .url(url.as_url().clone())
+        .build();
+    assert_eq!(
+        evaluate_javascript(&servo_test, webview.clone(), "window.firstHeadValue"),
+        Ok(JSValue::Number(41.0))
+    );
+    manager.remove_script(first);
+    manager.add_script(Rc::new(UserScript::from("window.menuBridgeValue = 73;")));
+    webview.reload();
+    assert_eq!(
+        evaluate_javascript(&servo_test, webview, "window.firstHeadValue"),
+        Ok(JSValue::Number(73.0))
+    );
+}
