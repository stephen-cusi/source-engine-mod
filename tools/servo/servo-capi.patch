+use std::future::{ready, Future};
+use std::pin::Pin;
+
+use servo_api::protocol_handler::{DoneChannel, FetchContext, NetworkError, ProtocolHandler, Request, Response};
+
+pub struct AssetProtocol;
+
+impl ProtocolHandler for AssetProtocol {
+    fn load<'a>(
+        &'a self,
+        _request: &'a mut Request,
+        _done: &mut DoneChannel,
+        _context: &FetchContext,
+    ) -> Pin<Box<dyn Future<Output = Response> + Send + 'a>> {
+        Box::pin(ready(Response::network_error(NetworkError::ResourceLoadError(
+            "Asset resource was not handled by the embedder".into(),
+        ))))
+    }
+
+    fn is_fetchable(&self) -> bool {
+        true
+    }
+}
