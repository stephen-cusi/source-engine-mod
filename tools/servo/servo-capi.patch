+/// Replaces the user script injected into future documents for this WebView.
+/// Changes take effect on the next navigation or reload, not the current page.
+/// An empty string removes the script. Returns 0 on success and -1 on invalid input.
+///
+/// # Safety
+///
+/// `webview` must be a live handle created by `servo_webview_builder_build`,
+/// and `script` must point to a valid NUL-terminated string. The call must run
+/// on the thread which created the WebView.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn servo_webview_set_document_script(
+    webview: *mut WebView,
+    script: *const c_char,
+) -> i32 {
+    if webview.is_null() || script.is_null() {
+        return -1;
+    }
+    let Ok(source) = (unsafe { CStr::from_ptr(script) }).to_str() else {
+        return -1;
+    };
+    if source.len() > 8 * 1024 * 1024 {
+        return -1;
+    }
+    let Some(manager) = (unsafe { &*webview }).user_content_manager() else {
+        return -1;
+    };
+    DOCUMENT_SCRIPTS.with(|scripts| {
+        let mut scripts = scripts.borrow_mut();
+        if let Some(previous) = scripts.remove(&(webview as usize)) {
+            manager.remove_script(previous);
+        }
+        if !source.is_empty() {
+            let next = Rc::new(UserScript::from(source));
+            manager.add_script(next.clone());
+            scripts.insert(webview as usize, next);
+        }
+    });
+    0
+}
