+/// Resolves one queued asset request. Must be called on the Servo owner thread.
+/// The supplied buffers are copied before this function returns.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn servo_asset_reply(
+    id: u64,
+    status: u16,
+    mime: *const c_char,
+    bytes: *const u8,
+    len: usize,
+) -> bool {
+    if !matches!(status, 200 | 404) || mime.is_null() || len > MAX_ASSET_BYTES || (len != 0 && bytes.is_null()) {
+        return false;
+    }
+    let Ok(content_type) = HeaderValue::from_bytes(unsafe { CStr::from_ptr(mime) }.to_bytes()) else {
+        return false;
+    };
+    let Some((_, load)) = ASSET_PENDING.with(|pending| pending.borrow_mut().remove(&id)) else {
+        return false;
+    };
+    let mut headers = HeaderMap::new();
+    headers.insert(header::CONTENT_TYPE, content_type);
+    let response = WebResourceResponse::new(load.request().url.clone().into_url())
+        .status_code(StatusCode::from_u16(status).unwrap())
+        .status_message(if status == 200 { b"OK".to_vec() } else { b"Not Found".to_vec() })
+        .headers(headers);
+    let body = if len == 0 { Vec::new() } else { unsafe { std::slice::from_raw_parts(bytes, len) }.to_vec() };
+    let mut intercepted = load.intercept(response);
+    // An empty chunk still marks an empty response body as complete.
+    intercepted.send_body_data(body);
+    intercepted.finish();
+    true
+}
