//
// Purpose: HL2SB reference source for the GMod private vertical blur.
//          Compiled programs shipped verbatim: shaders/fxc/g_blury_vs20.vcs
//          and shaders/fxc/g_blury_ps20.vcs.  waf does not run fxc on this
//          file; it documents the bytecode that ships (semantic-level
//          reconstruction, register use matches g_blury.cpp).
//
// $NoKeywords: $
//===========================================================================//

// ---- program g_blury_ps20 (ps_2_0) ----
// Same 13-tap gaussian as g_blurx_ps20 along Y.  c0.x = $size / backbuffer
// height.  Weight table identical to the X pass.
static const float gWeights[7] =
{
	0.199470997, 0.176033005, 0.120985001, 0.0647590011,
	0.0269949995, 0.00876399968, 0.00221600011
};

float4 mainPS( float2 uv : TEXCOORD0 ) : COLOR0
{
	float pitch = c0.x;
	float4 acc = tex2D( BaseTextureSampler, uv ) * gWeights[0];
	[unroll]
	for ( int i = 1; i <= 6; ++i )
	{
		float o = pitch * i;
		acc += tex2D( BaseTextureSampler, uv + float2( 0, o ) ) * gWeights[i];
		acc += tex2D( BaseTextureSampler, uv - float2( 0, o ) ) * gWeights[i];
	}
	return acc;
}
