// ---- program g_premultiplied_ps20 (ps_2_0) ----
// Pure passthrough; the premultiplied semantics live in the blend state set
// by g_premultiplied.cpp (ONE / ONE_MINUS_SRC_ALPHA plus separate alpha
// SRC_ALPHA / ONE_MINUS_SRC_ALPHA).
float4 mainPS( float2 uv : TEXCOORD0 ) : COLOR0
{
	return tex2D( BaseTextureSampler, uv );
}
