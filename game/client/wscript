#! /usr/bin/env python
# encoding: utf-8

from waflib import Utils
import os
import vpc_parser

top = '.'
PROJECT_NAME = 'client'

def options(opt):
	return

games = {
	'hl2': ['client_base.vpc', 'client_hl2.vpc'],
	'hl2mp': ['client_base.vpc', 'client_hl2mp.vpc'],
	'hl1': ['client_base.vpc', 'client_hl1.vpc'],
	'episodic': ['client_base.vpc', 'client_episodic.vpc'],
	'portal': ['client_base.vpc', 'client_portal.vpc'],
	'hl1mp': ['client_base.vpc', 'client_hl1mp.vpc'],
	'cstrike': ['client_base.vpc', 'client_cstrike.vpc'],
	'dod': ['client_base.vpc', 'client_dod.vpc'],
	'hl2sb': ['client_base.vpc', 'client_hl2mp.vpc', 'client_lua.vpc'],
}

def configure(conf):
	game = conf.options.GAMES
	conf.env.GAMES = game

	conf.env.append_unique('DEFINES', ['DISABLE_STEAM=1'])

	if game not in games.keys():
		conf.fatal("Couldn't find game: ", game)

def build(bld):
	game = vpc_parser.parse_vpcs( bld.env, games[bld.env.GAMES], '../..' )
	# Optional holi recording module: FFmpeg and its codecs are linked into holi,
	# leaving the client loadable when the optional module is absent.
	ffmpeg_root = os.environ.get('HL2SB_HOLI_FFMPEG_ROOT', '') if bld.env.GAMES == 'hl2sb' else ''

	includes = [
		'.',
		'game_controls',
		'../../common',
		'../../public',
		'../../public/lua',
		'../../public/tier0',
		'../../public/tier1',
		'../../public/mathlib',
		'../../public/vphysics',
		'../../vgui2/include',
		'../../vgui2/controls',
		'../shared',
		'../../lua/luajit/src',
		'../../lua/etc',
		'../shared/lua'
	]

	libs = [
		'tier0',
		'particles',
		'dmxloader',
		'vgui_controls',
		'matsys_controls',
		'tier1',
		'tier2',
		'tier3',
		'mathlib',
		'vstdlib',
		'choreoobjects',
		'steam_api',
		'bitmap',
		'vtf',
		'RT',
		'ZLIB',
		'lua_shared',
		'sqlite3_amalg',
	]

	install_path = bld.env.PREFIX
	if bld.env.DEST_OS != 'android':
		install_path += '/'+bld.env.GAMES+'/bin'

	source = [ 'in_touch.cpp' ]
	if bld.env.DEST_OS == 'win32':
		libs += ['USER32']
	if bld.env.GAMES == 'hl2sb':
		if bld.env.DEST_OS == 'win32':
			libs += ['WININET']
		else:
			libs += ['CURL']
			if bld.env.DEST_OS == 'android':
				libs += ['SSL', 'CRYPTO']

	source += game["sources"] + ['../../public/tier0/memoverride.cpp']
	includes += game["includes"]
	defines = game["defines"]

	defines.remove('PROTECTED_THINGS_ENABLE')

	# HL2SB (sbrust): Lua C API now lives in lua_shared.dll, but consumers must
	# NOT define LUA_BUILD_AS_DLL: hundreds of the engine's own binding
	# functions (luasrclib.h/luamanager.h LUALIB_API/LUA_API) are DEFINED in
	# this DLL, and dllimport definitions are C2491.  Plain extern declarations
	# + the lua_shared import lib (use=['lua_shared'] thunk) is the standard
	# no-dllimport linking and works for everything.

	bld.shlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx',
		includes = includes,
		defines  = defines,
		use      = libs,
		install_path = install_path,
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx      = bld.get_taskgen_count()
	)

	if game and bld.env.GAMES == 'hl2sb':
		module_env = bld.env.derive()
		if bld.env.DEST_OS == 'linux':
			module_env.cxxshlib_PATTERN = '%s.so'
		elif bld.env.DEST_OS == 'darwin':
			module_env.cxxshlib_PATTERN = '%s.dylib'
		if ffmpeg_root:
			ffmpeg_libs = ['avformat', 'avcodec', 'avutil', 'swscale', 'swresample']
			system_libs = []
			if bld.env.DEST_OS == 'win32':
				# The prebuilt codec SDK uses the dynamic MSVC runtime. Match it
				# throughout this module instead of mixing /MT with /MD objects.
				for key in ('CFLAGS', 'CXXFLAGS'):
					module_env[key] = [flag for flag in module_env[key] if flag not in ('/MT', '/MTd', '/MDd')]
					module_env.append_unique(key, ['/MD'])
				system_libs = ['user32', 'bcrypt', 'ws2_32', 'ole32', 'strmiids', 'secur32', 'mfuuid']
			shared_test = os.environ.get('HL2SB_HOLI_SHARED_TEST') == '1'
			if not shared_test:
				ffmpeg_libs += ['vpx', 'theoraenc', 'theoradec', 'vorbisenc', 'vorbis', 'ogg']
			bld.shlib(
				source = ['lua/holi_video_module.cpp', 'lua/hl2sb_video_backend.cpp'],
				target = 'holi', name = 'holi', features = 'c cxx', env = module_env,
				includes = ['../../public', os.path.join(ffmpeg_root, 'include')],
				defines = ['HL2SB_VIDEO_FFMPEG'],
				lib = (ffmpeg_libs if shared_test else []) + system_libs,
				libpath = [os.path.join(ffmpeg_root, 'lib')],
				stlib = [] if shared_test else ffmpeg_libs,
				stlibpath = [os.path.join(ffmpeg_root, 'lib')],
				install_path = bld.env.LIBDIR, subsystem = bld.env.MSVC_SUBSYSTEM,
				idx = bld.get_taskgen_count()
			)
		bld.shlib(
			source = ['../../audio/audio_decoder_module.cpp', '../../vendor/miniaudio/audio_decoders.c'],
			target = 'miniaudio',
			name = 'miniaudio',
			features = 'c cxx',
			env = module_env,
			includes = ['../../public', '../../public/tier0', '../../public/tier1'],
			use = ['tier0', 'tier1', 'vstdlib'],
			install_path = bld.env.LIBDIR,
			subsystem = bld.env.MSVC_SUBSYSTEM,
			idx = bld.get_taskgen_count()
		)

