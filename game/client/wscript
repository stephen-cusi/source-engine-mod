#! /usr/bin/env python
# encoding: utf-8

from waflib import Utils
import os
import vpc_parser

top = '.'
PROJECT_NAME = 'client'

def options(opt):
	return

games = {
	'hl2': ['client_base.vpc', 'client_hl2.vpc'],
	'hl2mp': ['client_base.vpc', 'client_hl2mp.vpc'],
	'hl1': ['client_base.vpc', 'client_hl1.vpc'],
	'episodic': ['client_base.vpc', 'client_episodic.vpc'],
	'portal': ['client_base.vpc', 'client_portal.vpc'],
	'hl1mp': ['client_base.vpc', 'client_hl1mp.vpc'],
	'cstrike': ['client_base.vpc', 'client_cstrike.vpc'],
	'dod': ['client_base.vpc', 'client_dod.vpc'],
	'hl2sb': ['client_base.vpc', 'client_hl2mp.vpc', 'client_lua.vpc'],
}

def configure(conf):
	game = conf.options.GAMES
	conf.env.GAMES = game

	conf.env.append_unique('DEFINES', ['DISABLE_STEAM=1'])

	if game not in games.keys():
		conf.fatal("Couldn't find game: ", game)

def build(bld):
	game = vpc_parser.parse_vpcs( bld.env, games[bld.env.GAMES], '../..' )
	# Optional recording support: point to an FFmpeg development prefix with
	# include/, lib/ and (on Windows) bin/. It must enable libvpx, libtheora
	# and libvorbis. Tested with BtbN LGPL N-129267-g9ec5cf1aac-20261124.
	ffmpeg_root = os.environ.get('HL2SB_FFMPEG_ROOT', '') if bld.env.GAMES == 'hl2sb' else ''
	ffmpeg_libs = []
	ffmpeg_libpaths = []

	includes = [
		'.',
		'game_controls',
		'../../common',
		'../../public',
		'../../public/lua',
		'../../public/tier0',
		'../../public/tier1',
		'../../public/mathlib',
		'../../public/vphysics',
		'../../vgui2/include',
		'../../vgui2/controls',
		'../shared',
		'../../lua/luajit/src',
		'../../lua/etc',
		'../shared/lua'
	]

	libs = [
		'tier0',
		'particles',
		'dmxloader',
		'vgui_controls',
		'matsys_controls',
		'tier1',
		'tier2',
		'tier3',
		'mathlib',
		'vstdlib',
		'choreoobjects',
		'steam_api',
		'bitmap',
		'vtf',
		'RT',
		'ZLIB',
		'lua_shared',
		'sqlite3_amalg',
	]

	install_path = bld.env.PREFIX
	if bld.env.DEST_OS != 'android':
		install_path += '/'+bld.env.GAMES+'/bin'

	source = [ 'in_touch.cpp' ]
	if bld.env.DEST_OS == 'win32':
		libs += ['USER32']
	if bld.env.GAMES == 'hl2sb':
		if bld.env.DEST_OS == 'win32':
			libs += ['WININET']
		else:
			libs += ['CURL']
			if bld.env.DEST_OS == 'android':
				libs += ['SSL', 'CRYPTO']

	source += game["sources"] + ['../../public/tier0/memoverride.cpp']
	includes += game["includes"]
	defines = game["defines"]
	if ffmpeg_root:
		includes.append(os.path.join(ffmpeg_root, 'include'))
		ffmpeg_libpaths.append(os.path.join(ffmpeg_root, 'lib'))
		ffmpeg_libs = ['avformat', 'avcodec', 'avutil', 'swscale', 'swresample']
		defines.append('HL2SB_VIDEO_FFMPEG')
		if bld.env.DEST_OS == 'win32':
			ffmpeg_bin = os.path.join(ffmpeg_root, 'bin')
			ffmpeg_runtime = [os.path.join(ffmpeg_bin, name) for name in os.listdir(ffmpeg_bin)
				if name.lower().endswith('.dll') and name.lower().startswith(
					('avcodec-', 'avformat-', 'avutil-', 'swscale-', 'swresample-'))]
			if len(ffmpeg_runtime) != 5:
				bld.fatal('HL2SB_FFMPEG_ROOT must contain exactly one DLL for each FFmpeg dependency')
			bld.install_files(bld.env.LIBDIR, ffmpeg_runtime)
			license_file = os.path.join(ffmpeg_root, 'LICENSE.txt')
			if not os.path.isfile(license_file):
				bld.fatal('HL2SB_FFMPEG_ROOT must include the FFmpeg license')
			bld.install_as(os.path.join(bld.env.LIBDIR, 'ffmpeg-LICENSE.txt'), license_file)

	defines.remove('PROTECTED_THINGS_ENABLE')

	# HL2SB (sbrust): Lua C API now lives in lua_shared.dll, but consumers must
	# NOT define LUA_BUILD_AS_DLL: hundreds of the engine's own binding
	# functions (luasrclib.h/luamanager.h LUALIB_API/LUA_API) are DEFINED in
	# this DLL, and dllimport definitions are C2491.  Plain extern declarations
	# + the lua_shared import lib (use=['lua_shared'] thunk) is the standard
	# no-dllimport linking and works for everything.

	bld.shlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx',
		includes = includes,
		defines  = defines,
		use      = libs,
		lib      = ffmpeg_libs,
		libpath  = ffmpeg_libpaths,
		install_path = install_path,
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx      = bld.get_taskgen_count()
	)

	if game and bld.env.GAMES == 'hl2sb':
		module_env = bld.env.derive()
		if bld.env.DEST_OS == 'linux':
			module_env.cxxshlib_PATTERN = '%s.so'
		elif bld.env.DEST_OS == 'darwin':
			module_env.cxxshlib_PATTERN = '%s.dylib'
		bld.shlib(
			source = ['../../audio/audio_decoder_module.cpp', '../../vendor/miniaudio/audio_decoders.c'],
			target = 'miniaudio',
			name = 'miniaudio',
			features = 'c cxx',
			env = module_env,
			includes = ['../../public', '../../public/tier0', '../../public/tier1'],
			use = ['tier0', 'tier1', 'vstdlib'],
			install_path = bld.env.LIBDIR,
			subsystem = bld.env.MSVC_SUBSYSTEM,
			idx = bld.get_taskgen_count()
		)

