//-----------------------------------------------------------------------------
//	SERVER_HL2MP.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro GAMENAME 	"hl2mp" [!$SOURCESDK]
$Macro GAMENAME 	"mod_hl2mp" [$SOURCESDK]

$Include "$SRCDIR\game\server\server_base.vpc"
$Include "$SRCDIR\game\server\nav_mesh.vpc" [$SOURCESDK]

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;$SRCDIR\game\shared\hl2,.\hl2,.\hl2mp,$SRCDIR\game\shared\hl2mp;.\lua;.\shared\lua"
		$PreprocessorDefinitions		"$BASE;HL2MP;HL2_DLL;HL2SB;ARGG;LUA_SDK"
	}
}

$Project "Server (HL2MP)"
{
	$Folder "Server Lua"
	{
		$File "$SRCDIR/game/shared/lua/luamanager.cpp"
		$File "$SRCDIR/game/shared/lua/lhl2sb.cpp"

		// HL2SB: Experiment-style binding framework + ported libraries
		$File "$SRCDIR/game/shared/lua/luabinding.cpp"
		$File "$SRCDIR/game/shared/lua/lentities.cpp"
		$File "$SRCDIR/game/shared/lua/lbaseflex_shared.cpp"
		$File "$SRCDIR/game/shared/lua/lbaseanimating_shared.cpp"
		$File "$SRCDIR/game/shared/lua/lparticle_system.cpp"
		$File "$SRCDIR/game/shared/lua/lsystem.cpp"
		$File "$SRCDIR/public/lsounds.cpp"
		$File "$SRCDIR/game/shared/lua/llocalization.cpp"
		$File "$SRCDIR/public/lenumerations_shared.cpp"
		$File "$SRCDIR/public/lenumerations.cpp"
		// TODO(port): Files/FileHandle need the helper layer above plus a decision on
		// how they coexist with the Team Sandbox era `filesystem` library.
		// Lua 5.1 API shims so the Team Sandbox era bindings build against 5.4
		$File "$SRCDIR/public/lgameevents.cpp"
		$File "$SRCDIR/public/lua_compat.cpp"

		$File "lua/lbaseanimating.cpp"
		$File "lua/lbaseentity.cpp"
		$File "lua/lentitylist.cpp"
		$File "lua/lplayer.cpp"
		$File "lua/lrecipientfilter.cpp"
		$File "lua/lutil.cpp"
		$File "lua/basescriptedtrigger.cpp"
		$File "lua/lhl2_player.cpp"
		$File "lua/leffects.cpp"
		
		$File "$SRCDIR/game/shared/lua/lbaseplayer_shared.cpp"
		$File "$SRCDIR/game/shared/lua/lbaseentity_shared.cpp"
		$File "$SRCDIR/game/shared/lua/lbasecombatweapon_shared.cpp"
		$File "$SRCDIR/game/shared/lua/lshareddefs.cpp"
		$File "$SRCDIR/game/shared/lua/lutil_shared.cpp"
		$File "$SRCDIR/game/shared/lua/lsrcinit.cpp"
		$File "$SRCDIR/game/shared/lua/lnet.cpp"
		$File "$SRCDIR/game/shared/lua/leffect_dispatch_data.cpp"
		$File "$SRCDIR/game/shared/lua/lhl2mp_player_shared.cpp"
		$File "$SRCDIR/game/shared/lua/limovehelper.cpp"
		$File "$SRCDIR/game/shared/lua/lipredictionsystem.cpp"
		$File "$SRCDIR/game/shared/lua/lin_buttons.cpp"
		$File "$SRCDIR/game/shared/lua/basescripted.cpp"
		$File "$SRCDIR/game/shared/lua/ltakedamageinfo.cpp"
		$File "$SRCDIR/game/shared/lua/weapon_hl2mpbase_scriptedweapon.cpp"
		$File "$SRCDIR/game/shared/lua/mountaddons.cpp"

		$File "$SRCDIR/public/lua/licvar.cpp"
		$File "$SRCDIR/public/lua/lnetworkstringtabledefs.cpp"
		$File "$SRCDIR/public/lua/mathlib/lmathlib.cpp"
		$File "$SRCDIR/public/lua/mathlib/lvector.cpp"
		$File "$SRCDIR/public/lua/mathlib/lvmatrix.cpp"
		$File "$SRCDIR/public/lua/tier1/liconvar.cpp"
		$File "$SRCDIR/public/lua/tier1/lconvar.cpp"
		$File "$SRCDIR/public/lua/tier1/LKeyValues.cpp"
		$File "$SRCDIR/public/lua/tier0/ldbg.cpp"
		$File "$SRCDIR/public/lua/lgametrace.cpp"
		$File "$SRCDIR/public/lua/SoundEmitterSystem/lisoundemittersystembase.cpp"
		$File "$SRCDIR/public/lua/lvphysics_interface.cpp"
		$File "$SRCDIR/public/lua/engine/livdebugoverlay.cpp"
		$File "$SRCDIR/public/lua/leiface.cpp"
		$File "$SRCDIR/public/lua/lfilesystem.cpp"
		$File "$SRCDIR/public/lua/lglobalvars_base.cpp"
		$File "$SRCDIR/public/lua/lbspflags.cpp"
		$File "$SRCDIR/public/lua/vphysics/lperformance.cpp"
		$File "$SRCDIR/public/lua/linetchannelinfo.cpp"
		$File "$SRCDIR/public/lua/materialsystem/limaterial.cpp"
		$File "$SRCDIR/public/lua/vstdlib/lrandom.cpp"
		$File "$SRCDIR/public/lua/lColor.cpp"
	}

	$Folder "Half-Life 2 Sanbox"
	{
		$File "$SRCDIR/game/shared/hl2sb/weapon_toolgun.cpp"
		$File "$SRCDIR/game/shared/hl2sb/weapon_physgun.cpp"
		// HL2SB: Garry's Mod .gma addon archives (addons/*.gma)
		$File "$SRCDIR/game/shared/hl2sb/hl2sb_gma.cpp"
		$File "$SRCDIR/game/shared/hl2sb/hl2sb_gma.h"
		// HL2SB: Garry's Mod SWEP.HoldType -> Activity translation (weapon_base/sh_anim.lua)
		$File "$SRCDIR/game/shared/hl2sb/gmod_activity_translate.cpp"
		$File "$SRCDIR/game/shared/hl2sb/gmod_activity_translate.h"
		$File "$SRCDIR/game/server/hl2sb_undo.cpp"
		$File "$SRCDIR/game/server/hl2sb_undo.h"
	}

	$Folder "Gunmod"
	{
		$File "gunmod/grenade_stickybomb.cpp"
	}

}
