//-----------------------------------------------------------------------------
//	SERVER_HL2MP.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro GAMENAME 	"hl2mp" [!$SOURCESDK]
$Macro GAMENAME 	"mod_hl2mp" [$SOURCESDK]

$Include "$SRCDIR\game\server\server_base.vpc"

//-----------------------------------------------------------------------------
// HL2SB: the nav mesh and the NextBot stack are listed HERE, flat, on purpose.
//
// Two other ways were tried and both fail:
//   * adding 'nav_mesh.vpc'/'nextbot.vpc' to game/server/wscript's vpcs list -
//     that edits a WSCRIPT, and waf's reconfigure tool then re-runs configure,
//     which is the long silent phase (minutes of CPU, no output, no cl.exe) that
//     looks exactly like a hang;
//   * include-ing those vpc files from here - this fork's vpc parser honours a
//     nested configuration block but NOT the file entries of a nested project
//     block, so every navmesh/NextBot symbol came out unresolved (LNK2019).
//
// A flat list in a file that is already in the build cannot fail either way:
// no wscript changes, so no reconfigure.
//
// ⚠️ waf caches the task graph in build/.wafpickle-*; deleting that file makes
// it re-read these lists without touching a wscript.
//
// ⚠️ Do NOT write a dollar-sign directive name inside a comment in this file:
// vpc_parser.py tests every LINE for the substring "File" and then splits it on
// a double quote, so a comment mentioning the file directive raises
// IndexError: list index out of range (that is not hypothetical - it happened).
//
// USE_NAV_MESH and NEXT_BOT themselves are in the preprocessor-definition line
// below (the former is what gameinterface.cpp's nav mesh load/update hooks need,
// the latter is what makes it call TheNextBots().Update()).
//-----------------------------------------------------------------------------

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;$SRCDIR\game\shared\hl2,.\hl2,.\hl2mp,$SRCDIR\game\shared\hl2mp;.\lua;.\shared\lua"
		$PreprocessorDefinitions		"$BASE;HL2MP;HL2_DLL;HL2SB;ARGG;LUA_SDK;USE_NAV_MESH;NEXT_BOT"
	}
}

$Project "Server (HL2MP)"
{
	$Folder "Server Lua"
	{
		$File "$SRCDIR/game/shared/lua/luamanager.cpp"
		$File "$SRCDIR/game/shared/lua/lhl2sb.cpp"

		// HL2SB: Experiment-style binding framework + ported libraries
		$File "$SRCDIR/game/shared/lua/luabinding.cpp"
		$File "$SRCDIR/game/shared/lua/lentities.cpp"
		$File "$SRCDIR/game/shared/lua/lbaseflex_shared.cpp"
		$File "$SRCDIR/game/shared/lua/lbaseanimating_shared.cpp"
		$File "$SRCDIR/game/shared/lua/lparticle_system.cpp"
		$File "$SRCDIR/game/shared/lua/lsystem.cpp"
		$File "$SRCDIR/public/lsounds.cpp"
		$File "$SRCDIR/game/shared/lua/llocalization.cpp"
		$File "$SRCDIR/public/lenumerations_shared.cpp"
		$File "$SRCDIR/public/lenumerations.cpp"
		// TODO(port): Files/FileHandle need the helper layer above plus a decision on
		// how they coexist with the Team Sandbox era `filesystem` library.
		// Lua 5.1 API shims so the Team Sandbox era bindings build against 5.4
		$File "$SRCDIR/public/lgameevents.cpp"
		$File "$SRCDIR/public/lua_compat.cpp"

		$File "lua/lbaseanimating.cpp"
		$File "lua/lbaseentity.cpp"
		$File "lua/lentitylist.cpp"
		$File "lua/lplayer.cpp"
		$File "lua/lrecipientfilter.cpp"
		$File "lua/lutil.cpp"
		$File "lua/basescriptedtrigger.cpp"
		$File "lua/lhl2_player.cpp"
		$File "lua/leffects.cpp"
		// HL2SB GMod compat: ENT.Type = "nextbot" - the Lua host over the NextBot
		// stack and the navmesh it paths on.
		$File "lua/luanextbot.cpp"
		$File "lua/luanextbot.h"
		$File "lua/lnavmesh.cpp"
		$File "lua/lnavmesh.h"

		//---------------------------------------------------------------------
		// GMod-compat navigation mesh (the base one, subversion 0 - the same
		// TheNavMesh GMod itself uses; the CS:GO bot mesh is a different class).
		// Same list as game/server/nav_mesh.vpc, compiled into this target
		// because USE_NAV_MESH is defined above.
		//---------------------------------------------------------------------
		$File "nav.h"
		$File "nav_area.cpp"
		$File "nav_area.h"
		$File "nav_colors.cpp"
		$File "nav_colors.h"
		$File "nav_edit.cpp"
		$File "nav_entities.cpp"
		$File "nav_entities.h"
		$File "nav_file.cpp"
		$File "nav_generate.cpp"
		$File "nav_ladder.cpp"
		$File "nav_ladder.h"
		$File "nav_merge.cpp"
		$File "nav_mesh.cpp"
		$File "nav_mesh.h"
		$File "nav_mesh_factory.cpp"
		$File "nav_node.cpp"
		$File "nav_node.h"
		$File "nav_pathfind.h"
		$File "nav_simplify.cpp"

		//---------------------------------------------------------------------
