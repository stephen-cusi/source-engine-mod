		$File "$SRCDIR/game/shared/lua/ltakedamageinfo.cpp"
		$File "$SRCDIR/game/shared/lua/weapon_hl2mpbase_scriptedweapon.cpp"
		$File "$SRCDIR/game/shared/lua/mountaddons.cpp"

		$File "$SRCDIR/public/lua/licvar.cpp"
		$File "$SRCDIR/public/lua/lnetworkstringtabledefs.cpp"
		$File "$SRCDIR/public/lua/mathlib/lmathlib.cpp"
		$File "$SRCDIR/public/lua/mathlib/lvector.cpp"
		$File "$SRCDIR/public/lua/mathlib/lvmatrix.cpp"
		$File "$SRCDIR/public/lua/tier1/liconvar.cpp"
